# 示例运行配置。实际部署配置文件名为 deploy.env，且不纳入版本控制。
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=5002
PLATFORM_RELOAD=false

# 格式：postgresql+asyncpg://用户名:URL编码后的密码@数据库主机:5432/数据库名
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform_user:replace_me@postgres:5432/automation_platform

PLATFORM_LOCAL_SHELL=/bin/bash
PLATFORM_ARTIFACT_STORAGE_ROOT=/data/artifacts
PLATFORM_REMOTE_ARTIFACT_ROOT=/tmp/automation-platform
PLATFORM_LOCAL_SCRIPT_ROOT=/data/local-scripts
PLATFORM_SCRIPT_FILE_TEMP_ROOT=/data/script-file-temp
PLATFORM_CORS_ORIGINS=

# 必填。生产环境使用长度至少为 16 位的随机强密码。
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_DISPLAY_NAME=管理员
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password

# 本地 HTTP 可设为 false；生产 HTTPS 设为 true。
PLATFORM_SESSION_COOKIE_SECURE=false
PLATFORM_SESSION_MAX_AGE_SECONDS=604800
PLATFORM_LOGIN_MAX_FAILURES=5
PLATFORM_LOGIN_LOCK_SECONDS=600

TZ=Asia/Shanghai
